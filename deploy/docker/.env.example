# Copy this file to .env and choose your own Superset secrets.
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=

# Leave local Redis and ClickHouse passwords empty, or set your own values.
REDIS_PASSWORD=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=sensors

# Required when ClickHouse credentials differ from the passwordless local default.
CLICKHOUSE_SQLALCHEMY_URI=clickhousedb://default:@clickhouse:8123/sensors
