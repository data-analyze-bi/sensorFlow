# Run ./install.sh to generate missing secrets automatically.
COMPOSE_PROFILES=redis-bundled,clickhouse-bundled
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SENSORFLOW_INGESTION_TOKEN=

# Superset is accessible through the server IP after installation.
SUPERSET_BIND_ADDRESS=0.0.0.0
SUPERSET_PORT=8088
SENSORFLOW_PUBLIC_HOST=
SUPERSET_PUBLIC_BASE_URL=

# Optional domains. Point DNS records to the server before starting Caddy.
SUPERSET_DOMAIN=
SENSORFLOW_DOMAIN=

# Leave local Redis and ClickHouse passwords empty, or set your own values.
REDIS_PASSWORD=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=sensors

# Required when ClickHouse credentials differ from the passwordless local default.
CLICKHOUSE_SQLALCHEMY_URI=clickhousedb://default:@clickhouse:8123/sensors
